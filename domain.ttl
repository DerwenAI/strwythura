@prefix strw:  <https://github.com/DerwenAI/strwythura/#> .

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix wd:   <http://www.wikidata.org/entity/> .

strw:lemma_phrase rdfs:domain skos:Concept ;
    rdfs:range rdf:langString
.

strw:DementiaScheme rdf:type skos:ConceptScheme , owl:Ontology ;
  dct:publisher <https://senzing.com/> ;
  skos:definition "A mid-level SKOS ontology about dementia research used in the `Strwythura` tutorial"@en ;
  skos:prefLabel "Dementia Example Vocabulary"@en
 .


strw:concept_people_group rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:topConceptOf strw:DementiaScheme ;
 skos:prefLabel "People Group"@en ;
 strw:lemma_phrase "NOUN.people NOUN.group"@en 
 .

strw:concept_person rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Person"@en ;
 strw:lemma_phrase "NOUN.person"@en ;
 skos:definition "any single member of Homo sapiens, unique extant species of the genus Homo"@en ;
 dct:identifier wd:Q5 ;
 skos:broader strw:concept_people_group
.

strw:concept_organization rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Organization"@en ;
 strw:lemma_phrase "NOUN.organization"@en ;
 skos:definition "social entity established to meet needs or pursue goals"@en ;
 dct:identifier wd:Q43229 ;
 skos:broader strw:concept_people_group
.

strw:concept_company rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Company"@en ;
 skos:altLabel "Enterprise"@en ;
 strw:lemma_phrase "NOUN.company"@en ;
 strw:lemma_phrase "NOUN.enterprise"@en ;
 skos:definition "legal entity representing an association of people, whether natural, legal or a mixture of both, with a specific objective"@en ;
 dct:identifier wd:Q783794 ;
 skos:broader strw:concept_organization
 .


strw:concept_location rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:topConceptOf strw:DementiaScheme ;
 skos:prefLabel "Location"@en ;
 strw:lemma_phrase "NOUN.location"@en ;
 skos:definition "property describing the position of something in space"@en ;
 dct:identifier wd:Q17334923
.

strw:concept_city rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "City"@en ;
 strw:lemma_phrase "NOUN.city"@en ;
 skos:definition "large human settlement"@en ;
 dct:identifier wd:Q515 ;
 skos:broader strw:concept_location
 .

strw:concept_country rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Country"@en ;
 strw:lemma_phrase "NOUN.country"@en ;
 skos:definition "distinct territorial body or political entity"@en ;
 dct:identifier wd:Q6256 ;
 skos:broader strw:concept_location
 .


strw:concept_science rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:topConceptOf strw:DementiaScheme ;
 skos:prefLabel "Science"@en ;
 strw:lemma_phrase "NOUN.science"@en ;
 skos:definition "systematic endeavor that builds and organizes knowledge, and the set of knowledge produced by this system"@en ;
 dct:identifier wd:Q336
 .

strw:concept_conference rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Conference"@en ;
 skos:altLabel "Convention"@en ;
 strw:lemma_phrase "NOUN.conference"@en ;
 skos:definition "meeting of a group of individuals and/or companies in a certain field"@en ;
 dct:identifier wd:Q625994 ;
 skos:broader strw:concept_company ;
 skos:broader strw:concept_organization
 .

strw:concept_publication rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Publication"@en ;
 skos:altLabel "Journal"@en ;
 strw:lemma_phrase "NOUN.publication"@en ;
 strw:lemma_phrase "NOUN.journal"@en ;
 skos:definition "content made available to the general public"@en ;
 dct:identifier wd:Q732577 ;
 skos:broader strw:concept_company ;
 skos:related strw:concept_conference
 .

strw:concept_research rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Research"@en ;
 strw:lemma_phrase "NOUN.research"@en ;
 skos:definition "systematic study undertaken to increase knowledge"@en ;
 dct:identifier wd:Q42240 ;
 skos:broader strw:concept_science ;
 skos:related strw:concept_publication
 .

strw:concept_medicine rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Medicine"@en ;
 strw:lemma_phrase "NOUN.medicine"@en ;
 skos:definition "field of study for diagnosing, treating and preventing disease"@en ;
 dct:identifier wd:Q11190 ;
 skos:broader strw:concept_science
 .


strw:concept_hospital rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Hospital"@en ;
 strw:lemma_phrase "NOUN.hospital"@en ;
 skos:definition "health care facility"@en ;
 dct:identifier wd:Q16917 ;
 skos:broader strw:concept_company, strw:concept_location ;
 skos:related strw:concept_medicine
 .

strw:concept_university rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "University"@en ;
 strw:lemma_phrase "NOUN.univerity"@en ;
 skos:definition "academic institution for further education"@en ;
 dct:identifier wd:Q3918 ;
 skos:broader strw:concept_company, strw:concept_location ;
 skos:related strw:concept_research
 .


strw:concept_food rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:topConceptOf strw:DementiaScheme ;
 skos:prefLabel "Food"@en ;
 skos:altLabel "Nutrition"@en ;
 strw:lemma_phrase "NOUN.food"@en ;
 strw:lemma_phrase "NOUN.nutrition"@en ;
 skos:definition "any substance consumed to provide nutritional support for the body; form of energy stored in chemical"@en ;
 dct:identifier wd:Q2095
 .

strw:concept_food_additive rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Food Additive"@en ;
 skos:altLabel "Additive"@en ;
 strw:lemma_phrase "NOUN.food NOUN.additive"@en ;
 strw:lemma_phrase "NOUN.additive"@en ;
 skos:definition "substances added to food to preserve flavor or enhance its taste, appearance, or other qualities"@en ;
 dct:identifier wd:Q189567 ;
 skos:broader strw:concept_food
 .


strw:concept_behavior rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:topConceptOf strw:DementiaScheme ;
 skos:prefLabel "Behavior"@en ;
 strw:lemma_phrase "NOUN.behavior"@en ;
 skos:definition "range of actions by entities, living or not, within a system"@en ;
 dct:identifier wd:Q9332
 .


strw:concept_organ rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:topConceptOf strw:DementiaScheme ;
 skos:prefLabel "Organ"@en ;
 strw:lemma_phrase "NOUN.organ"@en ;
 skos:definition "collection of tissues with similar functions"@en ;
 dct:identifier wd:Q712378
 .


strw:concept_condition rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:topConceptOf strw:DementiaScheme ;
 skos:prefLabel "Condition"@en ;
 strw:lemma_phrase "NOUN.condition"@en ;
 skos:definition "relative state or circumstances of some object or event"@en ;
 dct:identifier wd:Q813912
 .

strw:concept_disease rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Disease"@en ;
 strw:lemma_phrase "NOUN.disease"@en ;
 skos:definition "abnormal condition negatively affecting organisms"@en ;
 dct:identifier wd:Q12136 ;
 skos:broader strw:concept_condition ;
 skos:related strw:concept_organ, strw:concept_behavior, strw:concept_medicine
 .


strw:concept_doctor rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Doctor"@en ;
 skos:altLabel "Physician"@en ;
 strw:lemma_phrase "NOUN.doctor"@en ;
 strw:lemma_phrase "NOUN.physician"@en ;
 skos:definition "professional who practices medicine"@en ;
 dct:identifier wd:Q39631 ;
 skos:broader strw:concept_person ;
 skos:related strw:concept_medicine, strw:concept_hospital
 .
