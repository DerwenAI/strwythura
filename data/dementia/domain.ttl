@prefix strw:  <https://github.com/DerwenAI/strwythura/wiki/vocab#> .
@prefix sz:    <https://github.com/senzing-garage/sz-semantics/wiki/ns#> .

@prefix dc:    <http://purl.org/dc/elements/1.1/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix wco:   <https://id.oclc.org/worldcat/ontology/> .
@prefix wd:    <http://www.wikidata.org/entity/> .


strw:DementiaScheme rdf:type skos:ConceptScheme ;
  dc:publisher <https://senzing.com/> ;
  dc:creator <https://orcid.org/0000-0003-3167-1539> ;
  skos:definition "A mid-level SKOS taxonomy about dementia research used in the `Strwythura` tutorial"@en ;
  skos:prefLabel "Strwythura example SKOS taxonomy about dementia research"@en
 .


strw:Company rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Company"@en ;
 skos:altLabel "Enterprise"@en ;
 sz:lemma_phrase "NOUN.company"@en ;
 sz:lemma_phrase "NOUN.enterprise"@en ;
 sz:ner_label true ;
 skos:definition "A company legal entity representing an association of people, whether natural, legal or a mixture of both, with a specific objective"@en ;
 dc:identifier wd:Q783794 ;
 skos:broader sz:Organization
 .


strw:Location rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:topConceptOf strw:DementiaScheme ;
 skos:prefLabel "Location"@en ;
 sz:lemma_phrase "NOUN.location"@en ;
 sz:ner_label true ;
 skos:definition "Location is a property describing the position of something in space"@en ;
 dc:identifier wd:Q17334923
.

strw:City rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 sz:ner_label true ;
 skos:prefLabel "City"@en ;
 sz:lemma_phrase "NOUN.city"@en ;
 sz:ner_label true ;
 skos:definition "A city is a large human settlement"@en ;
 dc:identifier wd:Q515 ;
 skos:broader strw:Location
 .

strw:Country rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Country"@en ;
 sz:lemma_phrase "NOUN.country"@en ;
 sz:ner_label true ;
 skos:definition "A country is a distinct territorial body or political entity"@en ;
 dc:identifier wd:Q6256 ;
 skos:broader strw:Location
 .


strw:Science rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:topConceptOf strw:DementiaScheme ;
 skos:prefLabel "Science"@en ;
 sz:lemma_phrase "NOUN.science"@en ;
 sz:ner_label true ;
 skos:definition "Science is the systematic endeavor that builds and organizes knowledge; also, the set of knowledge produced by this system"@en ;
 dc:identifier wd:Q336
 .

strw:Conference rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Conference"@en ;
 skos:altLabel "Convention"@en ;
 sz:lemma_phrase "NOUN.conference"@en ;
 sz:ner_label true ;
 skos:definition "A conference is professional meeting of a group of individuals or companies within a particular field"@en ;
 dc:identifier wd:Q625994 ;
 skos:broader strw:Company, strw:Location
 .

strw:Publication rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Publication"@en ;
 skos:altLabel "Journal"@en ;
 sz:lemma_phrase "NOUN.publication"@en ;
 sz:lemma_phrase "NOUN.journal"@en ;
 sz:ner_label true ;
 skos:definition "A publication is content from a conference which is made available to the general public"@en ;
 dc:identifier wd:Q732577 ;
 skos:broader strw:Company ;
 skos:related strw:Conference
 .

strw:Research rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Research"@en ;
 sz:lemma_phrase "NOUN.research"@en ;
 sz:ner_label true ;
 skos:definition "Research is a systematic study undertaken to increase knowledge"@en ;
 dc:identifier wd:Q42240 ;
 skos:broader strw:Science ;
 skos:related strw:Publication
 .

strw:Medicine rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Medicine"@en ;
 sz:lemma_phrase "NOUN.medicine"@en ;
 sz:ner_label true ;
 skos:definition "Medicine is the field of study for diagnosing, treating, and preventing disease"@en ;
 dc:identifier wd:Q11190 ;
 skos:broader strw:Science
 .


strw:Hospital rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Hospital"@en ;
 sz:lemma_phrase "NOUN.hospital"@en ;
 sz:ner_label true ;
 skos:definition "A hospital is a health care facility"@en ;
 dc:identifier wd:Q16917 ;
 skos:broader strw:Company, strw:Location ;
 skos:related strw:Medicine
 .

strw:University rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "University"@en ;
 sz:lemma_phrase "NOUN.univerity"@en ;
 sz:ner_label true ;
 skos:definition "A university is an academic institution for further education"@en ;
 dc:identifier wd:Q3918 ;
 skos:broader strw:Company, strw:Location ;
 skos:related strw:Research
 .


strw:Food rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:topConceptOf strw:DementiaScheme ;
 skos:prefLabel "Food"@en ;
 skos:altLabel "Nutrition"@en ;
 sz:lemma_phrase "NOUN.food"@en ;
 sz:lemma_phrase "NOUN.nutrition"@en ;
 sz:ner_label true ;
 skos:definition "Food is any substance consumed to provide nutritional support for the body; also, a form of energy stored in chemical"@en ;
 dc:identifier wd:Q2095
 .

strw:Food_Additive rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Food Additive"@en ;
 skos:altLabel "Additive"@en ;
 sz:lemma_phrase "NOUN.food NOUN.additive"@en ;
 sz:lemma_phrase "NOUN.additive"@en ;
 sz:ner_label true ;
 skos:definition "A food additive is a substance added to food to preserve flavor or enhance its taste, appearance, or other qualities"@en ;
 dc:identifier wd:Q189567 ;
 skos:broader strw:Food
 .


strw:Behavior rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:topConceptOf strw:DementiaScheme ;
 skos:prefLabel "Behavior"@en ;
 sz:lemma_phrase "NOUN.behavior"@en ;
 sz:ner_label true ;
 skos:definition "Behavior is a range of actions by entities, living or not, within a system"@en ;
 dc:identifier wd:Q9332
 .


strw:Organ rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:topConceptOf strw:DementiaScheme ;
 skos:prefLabel "Organ"@en ;
 sz:lemma_phrase "NOUN.organ"@en ;
 sz:ner_label true ;
 skos:definition "An organ is a collection of biological tissues with similar functions"@en ;
 dc:identifier wd:Q712378
 .


strw:Condition rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:topConceptOf strw:DementiaScheme ;
 skos:prefLabel "Condition"@en ;
 sz:lemma_phrase "NOUN.condition"@en ;
 sz:ner_label true ;
 skos:definition "A condition is a relative state or circumstances of some object or event"@en ;
 dc:identifier wd:Q813912
 .

strw:Disease rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Disease"@en ;
 sz:lemma_phrase "NOUN.disease"@en ;
 sz:ner_label true ;
 skos:definition "Disease is an abnormal condition negatively affecting organisms"@en ;
 dc:identifier wd:Q12136 ;
 skos:broader strw:Condition ;
 skos:related strw:Organ, strw:Behavior, strw:Medicine
 .


strw:Doctor rdf:type skos:Concept ;
 skos:inScheme strw:DementiaScheme ;
 skos:prefLabel "Doctor"@en ;
 skos:altLabel "Physician"@en ;
 sz:lemma_phrase "NOUN.doctor"@en ;
 sz:lemma_phrase "NOUN.physician"@en ;
 sz:ner_label true ;
 skos:definition "A doctor is a professional who practices medicine"@en ;
 dc:identifier wd:Q39631 ;
 skos:broader sz:Person ;
 skos:related strw:Medicine, strw:Hospital
 .


strw:within_chunk rdfs:domain skos:Concept ;
  rdfs:range rdfs:Literal ;
  skos:definition "the source text for an extracted entity"@en
.

strw:follows_lexically rdfs:domain skos:Concept ;
  rdfs:range skos:Concept ;
  skos:definition "a sequential co-occurrence of extracted entities within a lexical graph"@en
.

strw:co_occurs_with rdfs:domain skos:Concept ;
  rdfs:range skos:Concept ;
  skos:definition "a neighborhood co-occurrence of extracted entities within a lexical graph"@en
.

strw:compound_elem_of rdfs:domain skos:Concept ;
  rdfs:range skos:Concept ;
  skos:definition "an extracted entity which is potentially included in a longer phrase"@en
.


strw:author_of rdfs:domain sz:Person ;
  rdfs:range strw:Publication, strw:Research ;
  skos:definition "which people authored or commented on the study?"@en ;
  rdf:type strw:relation, dc:creator
.

strw:associated_with rdfs:domain strw:Food, strw:Food_Additive ;
  rdfs:range strw:Condition, strw:Disease ;
  skos:definition "which food or food additives are associated with which conditions or diseases?"@en ;
  rdf:type strw:relation
.
